# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# Public site URL, used for metadata/OG tags (app/layout.tsx)
NEXT_PUBLIC_SITE_URL=https://ouaqt.com

# ── Contact form ───────────────────────────────────────────────────────────
# The form posts to /api/contact, which emails the submission to OUAQT.
# Without RESEND_API_KEY the endpoint returns an error and the form tells the
# visitor to email directly. It never pretends a message was delivered.
#
# Setup:
#   1. Sign up at resend.com using ouaqt.mrt@gmail.com
#   2. Create an API key at resend.com/api-keys
#   3. Add RESEND_API_KEY in Vercel under Settings > Environment Variables
#
# Until a domain is verified with Resend, mail can only be delivered to the
# address that owns the account, which is why step 1 matters.
RESEND_API_KEY=

# Where submissions land. Defaults to ouaqt.mrt@gmail.com.
CONTACT_TO_EMAIL=ouaqt.mrt@gmail.com

# Sender. Must stay on Resend's shared address until you verify a domain,
# after which you can use something like "OUAQT <hello@ouaqt.com>".
CONTACT_FROM_EMAIL=OUAQT Website <onboarding@resend.dev>

# ── Builder database (Supabase) ────────────────────────────────────────────
# Test project: ouaqt-builder-test. Anonymous sign-ins must be on under
# Authentication > Sign In / Providers, or a draft has no owner to belong to.
#
# The two NEXT_PUBLIC_ values ship to the browser on purpose. Row level
# security is what protects the data, not secrecy of the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server code only. Goes past every row level security policy, so it never
# takes a NEXT_PUBLIC_ prefix and never reaches a client component.
# builder/db/server.ts is the only file that reads it.
SUPABASE_SERVICE_ROLE_KEY=

# Applying migrations from your own machine: `npm run db:push`.
# Dashboard > Connect > Session pooler. Not read at runtime, not needed in Vercel.
SUPABASE_DB_URL=

# Development only. A JSON object standing in for the settings table while
# Supabase is not configured, so the builder can be walked locally. It is
# ignored the moment the two NEXT_PUBLIC_SUPABASE_ values are set, and it
# never belongs in Vercel.
BUILDER_DEV_SETTINGS=

# Encrypts serial numbers at rest. Generate with: openssl rand -hex 32
# Changing it makes every existing serial unreadable to its owner.
SERIAL_SECRET=

# The domain behind an owner's login address: <phone digits>@this. Must
# resolve in DNS. Changing it after owners exist locks them out.
NEXT_PUBLIC_ACCOUNT_EMAIL_DOMAIN=

# Where the desktop app downloads from is no longer set here. It lives in the
# settings table, one address per trade and per system
# (installer_url_windows_pharmacy and so on), editable from the admin area.

# Signs the licence files the desktop app runs on. Generate a pair with
# `npm run licence:keys`. The public half is built into the desktop app;
# the private half stays here and in Vercel. Replacing it makes every
# licence already issued unverifiable.
LICENCE_SIGNING_KEY=
LICENCE_PUBLIC_KEY=
