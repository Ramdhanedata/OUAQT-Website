      "help": {
        "fr": "Si oui, chaque vente sépare la part de l'assurance et celle du client.",
        "ar": "إذا نعم، يفصل كل بيع بين حصة التأمين وحصة الزبون.",
        "en": "If yes, each sale separates what the insurer pays from what the customer pays."
      },
      "review": true,
      "default": false,
      "maps_to": [
        {
          "path": "features.pharmacy.insurance.enabled"
