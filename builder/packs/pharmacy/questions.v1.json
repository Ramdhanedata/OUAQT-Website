          "label": {
            "fr": "CNAM",
            "ar": "CNAM",
            "en": "CNAM"
          }
        },
        {
          "id": "cnass",
          "label": {
            "fr": "CNASS",
            "ar": "CNASS",
            "en": "CNASS"
          }
        },
        {
          "id": "other",
          "label": {
            "fr": "Une autre assurance",
            "ar": "تأمين آخر",
            "en": "Another insurer"
          }
        }
