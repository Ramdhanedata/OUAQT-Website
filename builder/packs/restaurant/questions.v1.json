{
  "bank": "restaurant",
  "version": 1,
  "questions": [
    {
      "id": "rs_service",
      "type": "multi_choice",
      "label": {
        "fr": "Comment servez-vous vos clients ?",
        "ar": "كيف تخدم زبائنك؟",
        "en": "How do you serve your customers?"
      },
      "review": true,
      "options": [
        {
          "id": "dine_in",
          "label": {
            "fr": "Sur place",
            "ar": "في المحل",
            "en": "Eat in"
          }
        },
        {
          "id": "takeaway",
          "label": {
            "fr": "À emporter",
            "ar": "للأخذ",
            "en": "Takeaway"
          }
        },
        {
          "id": "delivery",
          "label": {
            "fr": "En livraison",
            "ar": "توصيل",
            "en": "Delivery"
          }
        }
      ],
      "default": [
        "dine_in",
        "takeaway"
      ],
      "maps_to": [
        {
          "path": "features.restaurant.service"
        }
      ]
    },
    {
      "id": "rs_tables",
      "type": "number",
      "label": {
        "fr": "Combien de tables avez-vous ?",
        "ar": "كم طاولة لديك؟",
        "en": "How many tables do you have?"
      },
      "review": true,
      "show_if": {
        "question": "rs_service",
        "includes": "dine_in"
      },
      "min": 1,
      "max": 200,
      "default": 10,
      "maps_to": [
        {
          "path": "features.restaurant.tables"
        }
      ]
    }
  ]
}
